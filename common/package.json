      "types": "./dist/app/config/*.d.ts",
      "import": "./dist/app/config/*.js",
      "default": "./dist/app/config/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
